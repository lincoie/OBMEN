//Сжатие файла
//Метод считывает исходный файл и создает его сжатую .gz копию.
using System.IO;
using System.IO.Compression;

/// <summary>
/// Сжимает указанный файл с помощью GZip.
/// </summary>
/// <param name="sourceFile">Путь к исходному файлу.</param>
/// <param name="targetFile">Путь к создаваемому .gz архиву.</param>
public static void CompressFile(string sourceFile, string targetFile)
{
    // Открытие исходного файла для чтения
    using FileStream sourceStream = File.OpenRead(sourceFile);
    
    // Создание целевого файла для записи сжатых данных
    using FileStream targetStream = File.Create(targetFile);
    
    // Инициализация потока сжатия в режиме Compress
    using GZipStream compressionStream = new GZipStream(targetStream, CompressionMode.Compress);

    // Побайтовое копирование данных со сжатием "на лету"
    sourceStream.CopyTo(compressionStream);
}

//Распаковка файла
Метод восстанавливает сжатый файл .gz в его исходный формат.
using System.IO;
using System.IO.Compression;
/// </summary>
/// <param name="sourceFile">Путь к сжатому .gz файлу.</param>
/// <param name="targetFile">Путь для сохранения распакованного файла.</param>
public static void DecompressFile(string sourceFile, string targetFile)
{
    // Открытие архивного файла для чтения
    using FileStream sourceStream = File.OpenRead(sourceFile);
    
    // Инициализация потока сжатия в режиме Decompress
    using GZipStream decompressionStream = new GZipStream(sourceStream, CompressionMode.Decompress);
    
    // Создание файла для сохранения восстановленных данных
    using FileStream targetStream = File.Create(targetFile);

    // Копирование распакованного потока в целевой файл
    decompressionStream.CopyTo(targetStream);
}

Сжатие и распаковка строк (в памяти)
using System.IO;
using System.IO.Compression;
using System.Text;

/// <summary>
/// Сжимает текстовую строку в массив байт GZip.
/// </summary>
public static byte[] CompressString(string text)
{
    byte[] buffer = Encoding.UTF8.GetBytes(text);
    using MemoryStream ms = new MemoryStream();
    
    // Блок using гарантирует Flush и закрытие потока сжатия до вызова ToArray()
    using (GZipStream zip = new GZipStream(ms, CompressionMode.Compress))
    {
        zip.Write(buffer, 0, buffer.Length);
    }
    
    return ms.ToArray();
}

/// <summary>
/// Распаковывает массив байт GZip обратно в строку.
/// </summary>
public static string DecompressString(byte[] compressedBytes)
{
    using MemoryStream ms = new MemoryStream(compressedBytes);
    using GZipStream zip = new GZipStream(ms, CompressionMode.Decompress);
    using StreamReader reader = new StreamReader(zip, Encoding.UTF8);
    
    return reader.ReadToEnd();
}
